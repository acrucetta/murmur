#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_BIN="$ROOT_DIR/.build/debug/MurmurMenuBarApp"
PID_FILE="/tmp/murmur-menubar.pid"
LOG_FILE="/tmp/murmur-menubar.log"
TRANSCRIPT_DIR="${MURMUR_TRANSCRIPTS_DIR:-$HOME/Library/Application Support/Murmur/transcriptions}"
CONFIG_DIR="${MURMUR_CONFIG_DIR:-$HOME/Library/Application Support/Murmur}"
SHORTCUT_FILE="$CONFIG_DIR/shortcut.txt"
DEFAULT_SHORTCUT="ctrl+shift+space"
COMMAND_NAME="${0##*/}"

usage() {
  cat <<USAGE
Usage:
  ${COMMAND_NAME} run [--model <id>]
  ${COMMAND_NAME} start [--model <id>]
  ${COMMAND_NAME} stop
  ${COMMAND_NAME} restart [--model <id>]
  ${COMMAND_NAME} status
  ${COMMAND_NAME} logs
  ${COMMAND_NAME} history [lines]
  ${COMMAND_NAME} history-path
  ${COMMAND_NAME} shortcut get
  ${COMMAND_NAME} shortcut set [combo]
  ${COMMAND_NAME} shortcut reset
  ${COMMAND_NAME} doctor
  ${COMMAND_NAME} install
  ${COMMAND_NAME} uninstall

Environment overrides:
  MURMUR_MOONSHINE_PYTHON  Absolute python path (default: VIRTUAL_ENV/bin/python3, then .venv/bin/python3, then python3)
  MURMUR_MOONSHINE_SCRIPT  Moonshine bridge script path
  MURMUR_SHORTCUT          Hotkey combo override (for example: ctrl+shift+space)
  MURMUR_TRANSCRIPTS_DIR   Transcription history folder (default: ~/Library/Application Support/Murmur/transcriptions)
  MURMUR_CONFIG_DIR        Config folder (default: ~/Library/Application Support/Murmur)
  MURMUR_BIN_DIR           Install directory for global CLI (default: ~/.local/bin)
USAGE
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

resolve_python() {
  local env_python="${MURMUR_MOONSHINE_PYTHON:-}"
  env_python="$(trim "$env_python")"
  if [[ -n "$env_python" ]]; then
    printf '%s\n' "$env_python"
    return
  fi

  local venv_env="${VIRTUAL_ENV:-}"
  venv_env="$(trim "$venv_env")"
  if [[ -n "$venv_env" && -x "$venv_env/bin/python3" ]]; then
    printf '%s\n' "$venv_env/bin/python3"
    return
  fi

  if [[ -x "$ROOT_DIR/.venv/bin/python3" ]]; then
    printf '%s\n' "$ROOT_DIR/.venv/bin/python3"
    return
  fi

  printf '%s\n' "python3"
}

resolve_script() {
  local env_script="${MURMUR_MOONSHINE_SCRIPT:-}"
  env_script="$(trim "$env_script")"
  if [[ -n "$env_script" ]]; then
    printf '%s\n' "$env_script"
    return
  fi

  if [[ -f "$ROOT_DIR/scripts/moonshine_transcribe.py" ]]; then
    printf '%s\n' "$ROOT_DIR/scripts/moonshine_transcribe.py"
    return
  fi

  printf '%s\n' "scripts/moonshine_transcribe.py"
}

resolve_shortcut() {
  local env_shortcut="${MURMUR_SHORTCUT:-}"
  env_shortcut="$(trim "$env_shortcut")"
  if [[ -n "$env_shortcut" ]]; then
    printf '%s\n' "$env_shortcut"
    return
  fi

  if [[ -f "$SHORTCUT_FILE" ]]; then
    local file_shortcut
    file_shortcut="$(head -n 1 "$SHORTCUT_FILE" 2>/dev/null || true)"
    file_shortcut="$(trim "$file_shortcut")"
    if [[ -n "$file_shortcut" ]]; then
      printf '%s\n' "$file_shortcut"
      return
    fi
  fi

  printf '%s\n' "$DEFAULT_SHORTCUT"
}

shortcut_source() {
  local env_shortcut="${MURMUR_SHORTCUT:-}"
  env_shortcut="$(trim "$env_shortcut")"
  if [[ -n "$env_shortcut" ]]; then
    printf '%s\n' "env:MURMUR_SHORTCUT"
    return
  fi
  if [[ -f "$SHORTCUT_FILE" ]]; then
    printf '%s\n' "file:$SHORTCUT_FILE"
    return
  fi
  printf '%s\n' "default"
}

shortcut_get() {
  echo "shortcut=$(resolve_shortcut)"
  echo "source=$(shortcut_source)"
}

shortcut_set() {
  local shortcut="${1:-}"
  shortcut="$(trim "$shortcut")"
  if [[ -z "$shortcut" ]]; then
    if [[ ! -t 0 || ! -t 1 ]]; then
      echo "shortcut value is required in non-interactive mode" >&2
      return 2
    fi

    ensure_capture_build
    local capture_output
    if ! capture_output="$("$ROOT_DIR/.build/debug/DictationPreviewCLI" --capture-shortcut)"; then
      echo "shortcut capture failed" >&2
      return 1
    fi

    local captured
    captured="$(printf '%s\n' "$capture_output" | sed -n 's/^shortcut=//p' | head -n 1)"
    captured="$(trim "$captured")"
    if [[ -z "$captured" ]]; then
      echo "$capture_output" >&2
      echo "shortcut capture did not return a valid combo" >&2
      return 1
    fi

    shortcut="$captured"
    echo "captured shortcut: $shortcut"
    read -r -p "Use this shortcut? [y/N] " confirm
    case "${confirm:-}" in
      y|Y|yes|YES)
        ;;
      *)
        echo "shortcut update cancelled"
        return 1
        ;;
    esac
  fi

  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$shortcut" >"$SHORTCUT_FILE"
  echo "shortcut set to $shortcut"
  echo "config_file=$SHORTCUT_FILE"
  if is_running; then
    echo "note: restart murmur for shortcut changes to apply"
  fi
}

shortcut_reset() {
  rm -f "$SHORTCUT_FILE"
  echo "shortcut reset to default ($DEFAULT_SHORTCUT)"
  if is_running; then
    echo "note: restart murmur for shortcut changes to apply"
  fi
}

shortcut_command() {
  local action="${1:-get}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$action" in
    get)
      shortcut_get
      ;;
    set)
      shortcut_set "$@"
      ;;
    reset)
      shortcut_reset
      ;;
    *)
      echo "unknown shortcut action: $action" >&2
      echo "usage: $COMMAND_NAME shortcut [get|set [combo]|reset]" >&2
      return 2
      ;;
  esac
}

ensure_build() {
  (cd "$ROOT_DIR" && swift build --product MurmurMenuBarApp >/dev/null)
}

ensure_capture_build() {
  (cd "$ROOT_DIR" && swift build --product DictationPreviewCLI >/dev/null)
}

is_running() {
  if [[ ! -f "$PID_FILE" ]]; then
    return 1
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  if [[ -z "$pid" ]]; then
    return 1
  fi

  if kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  rm -f "$PID_FILE"
  return 1
}

start_bg() {
  if is_running; then
    echo "murmur already running (pid $(cat "$PID_FILE"))"
    return 0
  fi

  local python_bin script_path shortcut_identifier
  python_bin="$(resolve_python)"
  script_path="$(resolve_script)"
  shortcut_identifier="$(resolve_shortcut)"

  ensure_build
  (
    cd "$ROOT_DIR"
    nohup "$APP_BIN" --moonshine-python "$python_bin" --moonshine-script "$script_path" --shortcut "$shortcut_identifier" "$@" >"$LOG_FILE" 2>&1 &
    echo $! >"$PID_FILE"
  )

  sleep 0.2
  if is_running; then
    echo "murmur started (pid $(cat "$PID_FILE"))"
    echo "log: $LOG_FILE"
  else
    echo "failed to start murmur; see $LOG_FILE" >&2
    return 1
  fi
}

run_fg() {
  local python_bin script_path shortcut_identifier
  python_bin="$(resolve_python)"
  script_path="$(resolve_script)"
  shortcut_identifier="$(resolve_shortcut)"

  ensure_build
  cd "$ROOT_DIR"
  exec "$APP_BIN" --moonshine-python "$python_bin" --moonshine-script "$script_path" --shortcut "$shortcut_identifier" "$@"
}

stop_bg() {
  if ! is_running; then
    echo "murmur is not running"
    return 0
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  kill "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "murmur stopped"
}

status_bg() {
  if is_running; then
    local pid
    pid="$(cat "$PID_FILE")"
    echo "murmur running (pid $pid)"
    echo "log: $LOG_FILE"
  else
    echo "murmur not running"
  fi
}

history_path() {
  echo "$TRANSCRIPT_DIR"
}

history_show() {
  local line_count="${1:-50}"
  if [[ ! "$line_count" =~ ^[0-9]+$ ]]; then
    echo "history lines must be a number" >&2
    return 2
  fi

  if [[ ! -d "$TRANSCRIPT_DIR" ]]; then
    echo "no transcript history yet"
    return 0
  fi

  local files=()
  while IFS= read -r file; do
    files+=("$file")
  done < <(find "$TRANSCRIPT_DIR" -type f -name '*.txt' | sort)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "no transcript history yet"
    return 0
  fi

  cat "${files[@]}" | tail -n "$line_count"
}

doctor() {
  echo "repo=$ROOT_DIR"
  echo "binary=$APP_BIN"
  echo "python=$(resolve_python)"
  echo "moonshine_script=$(resolve_script)"
  echo "shortcut=$(resolve_shortcut)"
  echo "shortcut_source=$(shortcut_source)"
  echo "history_dir=$TRANSCRIPT_DIR"
  if is_running; then
    echo "status=running pid=$(cat "$PID_FILE")"
  else
    echo "status=stopped"
  fi
}

install_cli() {
  local install_dir="${MURMUR_BIN_DIR:-$HOME/.local/bin}"
  mkdir -p "$install_dir"
  ln -sfn "$ROOT_DIR/murmur" "$install_dir/murmur"
  echo "installed murmur -> $install_dir/murmur"
  case ":$PATH:" in
    *":$install_dir:"*) ;;
    *)
      echo "note: add $install_dir to PATH to run 'murmur' from anywhere"
      ;;
  esac
}

uninstall_cli() {
  local install_dir="${MURMUR_BIN_DIR:-$HOME/.local/bin}"
  rm -f "$install_dir/murmur"
  echo "removed $install_dir/murmur"
}

cmd="${1:-run}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
run)
  run_fg "$@"
  ;;
start)
  start_bg "$@"
  ;;
stop)
  stop_bg
  ;;
restart)
  stop_bg
  start_bg "$@"
  ;;
status)
  status_bg
  ;;
logs)
  touch "$LOG_FILE"
  tail -f "$LOG_FILE"
  ;;
history)
  history_show "$@"
  ;;
history-path)
  history_path
  ;;
shortcut)
  shortcut_command "$@"
  ;;
doctor)
  doctor
  ;;
install)
  install_cli
  ;;
uninstall)
  uninstall_cli
  ;;
help|-h|--help)
  usage
  ;;
*)
  usage >&2
  exit 2
  ;;
esac
