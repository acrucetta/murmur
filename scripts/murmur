#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_BIN="$ROOT_DIR/.build/debug/MurmurMenuBarApp"
PID_FILE="/tmp/murmur-menubar.pid"
LOG_FILE="/tmp/murmur-menubar.log"
TRANSCRIPT_DIR="${MURMUR_TRANSCRIPTS_DIR:-$HOME/Library/Application Support/Murmur/transcriptions}"
CONFIG_DIR="${MURMUR_CONFIG_DIR:-$HOME/Library/Application Support/Murmur}"
SHORTCUT_FILE="$CONFIG_DIR/shortcut.txt"
REWRITE_MODE_FILE="$CONFIG_DIR/rewrite_mode.txt"
OPENROUTER_MODEL_FILE="$CONFIG_DIR/openrouter_model.txt"
OPENROUTER_API_KEY_FILE="$CONFIG_DIR/openrouter_api_key.txt"
DEFAULT_SHORTCUT="ctrl+shift+space"
DEFAULT_REWRITE_MODE="smart"
DEFAULT_OPENROUTER_MODEL="mistralai/mistral-small-3.1-24b-instruct"
COMMAND_NAME="${0##*/}"

usage() {
  cat <<USAGE
Usage:
  ${COMMAND_NAME} setup [--python <python3>] [--skip-model-download] [--global]
  ${COMMAND_NAME} run [--model <id>] [--rewrite-mode <literal|smart>] [--openrouter-model <id>]
  ${COMMAND_NAME} start [--model <id>] [--rewrite-mode <literal|smart>] [--openrouter-model <id>]
  ${COMMAND_NAME} stop
  ${COMMAND_NAME} restart [--model <id>] [--rewrite-mode <literal|smart>] [--openrouter-model <id>]
  ${COMMAND_NAME} status
  ${COMMAND_NAME} logs
  ${COMMAND_NAME} history [lines]
  ${COMMAND_NAME} history-path
  ${COMMAND_NAME} config
  ${COMMAND_NAME} config [wizard|get|set]
  ${COMMAND_NAME} config set [--shortcut <combo>] [--reset-shortcut] [--mode literal|smart] [--model <id>] [--api-key <token>] [--clear-api-key]
  ${COMMAND_NAME} shortcut get
  ${COMMAND_NAME} shortcut set [combo]
  ${COMMAND_NAME} shortcut reset
  ${COMMAND_NAME} doctor
  ${COMMAND_NAME} install [--python <python3>] [--skip-model-download] [--link-only]
  ${COMMAND_NAME} uninstall

Environment overrides:
  MURMUR_MOONSHINE_PYTHON  Absolute python path (default: VIRTUAL_ENV/bin/python3, then .venv/bin/python3, then python3)
  MURMUR_MOONSHINE_SCRIPT  Moonshine bridge script path
  MURMUR_SETUP_PYTHON      Python executable used by setup (default: python3)
  MURMUR_SHORTCUT          Hotkey combo override (for example: ctrl+shift+space)
  MURMUR_REWRITE_MODE      Rewrite mode: literal|smart (default: smart)
  MURMUR_OPENROUTER_MODEL  OpenRouter model id for smart mode (default: mistralai/mistral-small-3.1-24b-instruct)
  MURMUR_OPENROUTER_API_KEY  OpenRouter API token (preferred)
  OPENROUTER_API_KEY       OpenRouter API token fallback
  MURMUR_TRANSCRIPTS_DIR   Transcription history folder (default: ~/Library/Application Support/Murmur/transcriptions)
  MURMUR_CONFIG_DIR        Config folder (default: ~/Library/Application Support/Murmur)
  MURMUR_BIN_DIR           Install directory for global CLI (default: ~/.local/bin)
USAGE
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

read_file_value() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    return
  fi
  local value
  value="$(head -n 1 "$path" 2>/dev/null || true)"
  value="$(trim "$value")"
  if [[ -n "$value" ]]; then
    printf '%s\n' "$value"
  fi
}

write_config_value() {
  local path="$1"
  local value="$2"
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$value" >"$path"
}

write_secret_config_value() {
  local path="$1"
  local value="$2"
  mkdir -p "$CONFIG_DIR"
  (umask 177; printf '%s\n' "$value" >"$path")
}

normalize_rewrite_mode() {
  local mode="$1"
  mode="$(trim "$mode")"
  mode="${mode,,}"
  case "$mode" in
    literal|smart)
      printf '%s\n' "$mode"
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

drain_tty_input() {
  if [[ ! -t 0 ]]; then
    return
  fi
  while IFS= read -r -s -n 1 -t 0.01 _; do :; done
}

resolve_python() {
  local env_python="${MURMUR_MOONSHINE_PYTHON:-}"
  env_python="$(trim "$env_python")"
  if [[ -n "$env_python" ]]; then
    printf '%s\n' "$env_python"
    return
  fi

  local venv_env="${VIRTUAL_ENV:-}"
  venv_env="$(trim "$venv_env")"
  if [[ -n "$venv_env" && -x "$venv_env/bin/python3" ]]; then
    printf '%s\n' "$venv_env/bin/python3"
    return
  fi

  if [[ -x "$ROOT_DIR/.venv/bin/python3" ]]; then
    printf '%s\n' "$ROOT_DIR/.venv/bin/python3"
    return
  fi

  printf '%s\n' "python3"
}

resolve_script() {
  local env_script="${MURMUR_MOONSHINE_SCRIPT:-}"
  env_script="$(trim "$env_script")"
  if [[ -n "$env_script" ]]; then
    printf '%s\n' "$env_script"
    return
  fi

  if [[ -f "$ROOT_DIR/scripts/moonshine_transcribe.py" ]]; then
    printf '%s\n' "$ROOT_DIR/scripts/moonshine_transcribe.py"
    return
  fi

  printf '%s\n' "scripts/moonshine_transcribe.py"
}

resolve_shortcut() {
  local env_shortcut="${MURMUR_SHORTCUT:-}"
  env_shortcut="$(trim "$env_shortcut")"
  if [[ -n "$env_shortcut" ]]; then
    printf '%s\n' "$env_shortcut"
    return
  fi

  if [[ -f "$SHORTCUT_FILE" ]]; then
    local file_shortcut
    file_shortcut="$(head -n 1 "$SHORTCUT_FILE" 2>/dev/null || true)"
    file_shortcut="$(trim "$file_shortcut")"
    if [[ -n "$file_shortcut" ]]; then
      printf '%s\n' "$file_shortcut"
      return
    fi
  fi

  printf '%s\n' "$DEFAULT_SHORTCUT"
}

resolve_rewrite_mode() {
  local mode
  local env_mode="${MURMUR_REWRITE_MODE:-}"
  env_mode="$(trim "$env_mode")"
  if [[ -n "$env_mode" ]]; then
    if mode="$(normalize_rewrite_mode "$env_mode" 2>/dev/null)"; then
      printf '%s\n' "$mode"
      return
    fi
    echo "warning: invalid MURMUR_REWRITE_MODE '$env_mode'; using defaults" >&2
  fi

  local file_mode
  file_mode="$(read_file_value "$REWRITE_MODE_FILE" || true)"
  if [[ -n "$file_mode" ]]; then
    if mode="$(normalize_rewrite_mode "$file_mode" 2>/dev/null)"; then
      printf '%s\n' "$mode"
      return
    fi
    echo "warning: invalid rewrite mode in $REWRITE_MODE_FILE ('$file_mode'); using defaults" >&2
  fi

  printf '%s\n' "$DEFAULT_REWRITE_MODE"
}

rewrite_mode_source() {
  local env_mode="${MURMUR_REWRITE_MODE:-}"
  env_mode="$(trim "$env_mode")"
  if [[ -n "$env_mode" ]]; then
    printf '%s\n' "env:MURMUR_REWRITE_MODE"
    return
  fi
  if [[ -f "$REWRITE_MODE_FILE" ]]; then
    printf '%s\n' "file:$REWRITE_MODE_FILE"
    return
  fi
  printf '%s\n' "default"
}

resolve_openrouter_model() {
  local env_model="${MURMUR_OPENROUTER_MODEL:-}"
  env_model="$(trim "$env_model")"
  if [[ -n "$env_model" ]]; then
    printf '%s\n' "$env_model"
    return
  fi

  local file_model
  file_model="$(read_file_value "$OPENROUTER_MODEL_FILE" || true)"
  if [[ -n "$file_model" ]]; then
    printf '%s\n' "$file_model"
    return
  fi

  printf '%s\n' "$DEFAULT_OPENROUTER_MODEL"
}

openrouter_model_source() {
  local env_model="${MURMUR_OPENROUTER_MODEL:-}"
  env_model="$(trim "$env_model")"
  if [[ -n "$env_model" ]]; then
    printf '%s\n' "env:MURMUR_OPENROUTER_MODEL"
    return
  fi
  if [[ -f "$OPENROUTER_MODEL_FILE" ]]; then
    printf '%s\n' "file:$OPENROUTER_MODEL_FILE"
    return
  fi
  printf '%s\n' "default"
}

resolve_openrouter_api_key() {
  local env_key="${MURMUR_OPENROUTER_API_KEY:-}"
  env_key="$(trim "$env_key")"
  if [[ -n "$env_key" ]]; then
    printf '%s\n' "$env_key"
    return
  fi

  local env_fallback="${OPENROUTER_API_KEY:-}"
  env_fallback="$(trim "$env_fallback")"
  if [[ -n "$env_fallback" ]]; then
    printf '%s\n' "$env_fallback"
    return
  fi

  local file_key
  file_key="$(read_file_value "$OPENROUTER_API_KEY_FILE" || true)"
  if [[ -n "$file_key" ]]; then
    printf '%s\n' "$file_key"
    return
  fi
}

openrouter_api_key_source() {
  local env_key="${MURMUR_OPENROUTER_API_KEY:-}"
  env_key="$(trim "$env_key")"
  if [[ -n "$env_key" ]]; then
    printf '%s\n' "env:MURMUR_OPENROUTER_API_KEY"
    return
  fi

  local env_fallback="${OPENROUTER_API_KEY:-}"
  env_fallback="$(trim "$env_fallback")"
  if [[ -n "$env_fallback" ]]; then
    printf '%s\n' "env:OPENROUTER_API_KEY"
    return
  fi

  if [[ -f "$OPENROUTER_API_KEY_FILE" ]]; then
    printf '%s\n' "file:$OPENROUTER_API_KEY_FILE"
    return
  fi

  printf '%s\n' "unset"
}

openrouter_key_present() {
  local key
  key="$(resolve_openrouter_api_key || true)"
  key="$(trim "$key")"
  if [[ -n "$key" ]]; then
    printf '%s\n' "yes"
    return
  fi
  printf '%s\n' "no"
}

shortcut_source() {
  local env_shortcut="${MURMUR_SHORTCUT:-}"
  env_shortcut="$(trim "$env_shortcut")"
  if [[ -n "$env_shortcut" ]]; then
    printf '%s\n' "env:MURMUR_SHORTCUT"
    return
  fi
  if [[ -f "$SHORTCUT_FILE" ]]; then
    printf '%s\n' "file:$SHORTCUT_FILE"
    return
  fi
  printf '%s\n' "default"
}

shortcut_get() {
  echo "shortcut=$(resolve_shortcut)"
  echo "source=$(shortcut_source)"
}

show_restart_note_if_running() {
  if is_running; then
    echo "note: restart murmur for config changes to apply"
  fi
}

ensure_interactive_tty() {
  if [[ -t 0 && -t 1 ]]; then
    return 0
  fi
  echo "interactive config requires a TTY. use '${COMMAND_NAME} config set --mode/--shortcut/...' in non-interactive contexts." >&2
  return 2
}

write_shortcut_value() {
  local shortcut="$1"
  write_config_value "$SHORTCUT_FILE" "$shortcut"
}

clear_shortcut_value() {
  rm -f "$SHORTCUT_FILE"
}

capture_shortcut_value() {
  ensure_capture_build

  local capture_output
  if ! capture_output="$("$ROOT_DIR/.build/debug/DictationPreviewCLI" --capture-shortcut < /dev/tty)"; then
    echo "shortcut capture failed" >&2
    return 1
  fi

  local captured
  captured="$(printf '%s\n' "$capture_output" | sed -n 's/^shortcut=//p' | head -n 1)"
  captured="$(trim "$captured")"
  if [[ -z "$captured" ]]; then
    echo "$capture_output" >&2
    echo "shortcut capture did not return a valid combo" >&2
    return 1
  fi

  printf '%s\n' "$captured"
}

confirm_yes_no() {
  local prompt="$1"
  local default_no="${2:-yes}"
  local input
  drain_tty_input
  if ! read -r -p "$prompt" input < /dev/tty; then
    return 1
  fi
  input="$(trim "$input")"
  case "${input,,}" in
    y|yes)
      return 0
      ;;
    n|no)
      return 1
      ;;
    "")
      if [[ "$default_no" == "yes" ]]; then
        return 1
      fi
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

shortcut_set() {
  local shortcut="${1:-}"
  shortcut="$(trim "$shortcut")"

  if [[ -z "$shortcut" ]]; then
    if ! ensure_interactive_tty; then
      echo "shortcut value is required in non-interactive mode" >&2
      return 2
    fi
    shortcut="$(capture_shortcut_value)"
    echo "captured shortcut: $shortcut"
    if ! confirm_yes_no "Use this shortcut? [y/N] " "yes"; then
      echo "shortcut update cancelled"
      return 1
    fi
  fi

  write_shortcut_value "$shortcut"
  echo "shortcut set to $shortcut"
  echo "config_file=$SHORTCUT_FILE"
  show_restart_note_if_running
}

shortcut_reset() {
  clear_shortcut_value
  echo "shortcut reset to default ($DEFAULT_SHORTCUT)"
  show_restart_note_if_running
}

shortcut_command() {
  local action="${1:-get}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$action" in
    get)
      shortcut_get
      ;;
    set)
      shortcut_set "$@"
      ;;
    reset)
      shortcut_reset
      ;;
    *)
      echo "unknown shortcut action: $action" >&2
      echo "usage: $COMMAND_NAME shortcut [get|set [combo]|reset]" >&2
      return 2
      ;;
  esac
}

config_usage() {
  cat <<USAGE
usage: ${COMMAND_NAME} config [wizard|get|set]

examples:
  ${COMMAND_NAME} config
  ${COMMAND_NAME} config wizard
  ${COMMAND_NAME} config get
  ${COMMAND_NAME} config set --shortcut ctrl+option+space
  ${COMMAND_NAME} config set --reset-shortcut
  ${COMMAND_NAME} config set --mode smart --model mistralai/mistral-small-3.1-24b-instruct
  ${COMMAND_NAME} config set --api-key sk-or-...
  ${COMMAND_NAME} config set --clear-api-key
USAGE
}

config_get() {
  echo "rewrite_mode=$(resolve_rewrite_mode)"
  echo "rewrite_mode_source=$(rewrite_mode_source)"
  echo "openrouter_model=$(resolve_openrouter_model)"
  echo "openrouter_model_source=$(openrouter_model_source)"
  echo "openrouter_api_key_present=$(openrouter_key_present)"
  echo "openrouter_api_key_source=$(openrouter_api_key_source)"
}

run_swift_config_wizard() {
  local cli_bin="$ROOT_DIR/.build/debug/DictationPreviewCLI"
  if [[ ! -x "$cli_bin" ]]; then
    ensure_capture_build
  fi
  "$cli_bin" \
    --config-wizard \
    --config-dir "$CONFIG_DIR" \
    --default-shortcut "$DEFAULT_SHORTCUT" \
    --default-rewrite-mode "$DEFAULT_REWRITE_MODE" \
    --default-openrouter-model "$DEFAULT_OPENROUTER_MODEL"
}

config_set_interactive() {
  if ! ensure_interactive_tty; then
    return 2
  fi
  if ! run_swift_config_wizard; then
    return $?
  fi

  echo "config updated:"
  config_get
  shortcut_get
  show_restart_note_if_running
}

config_set_non_interactive() {
  local mode="" model="" api_key="" shortcut="" clear_api_key=0 reset_shortcut=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)
        if [[ $# -lt 2 ]]; then
          echo "--mode requires a value (literal|smart)" >&2
          return 2
        fi
        mode="$2"
        shift 2
        ;;
      --model)
        if [[ $# -lt 2 ]]; then
          echo "--model requires a value" >&2
          return 2
        fi
        model="$2"
        shift 2
        ;;
      --api-key)
        if [[ $# -lt 2 ]]; then
          echo "--api-key requires a value" >&2
          return 2
        fi
        api_key="$2"
        shift 2
        ;;
      --shortcut)
        if [[ $# -lt 2 ]]; then
          echo "--shortcut requires a value" >&2
          return 2
        fi
        shortcut="$2"
        shift 2
        ;;
      --reset-shortcut)
        reset_shortcut=1
        shift
        ;;
      --clear-api-key)
        clear_api_key=1
        shift
        ;;
      -h|--help)
        config_usage
        return 0
        ;;
      *)
        echo "unknown config option: $1" >&2
        config_usage >&2
        return 2
        ;;
    esac
  done

  if [[ "$reset_shortcut" -eq 1 && -n "$(trim "$shortcut")" ]]; then
    echo "--shortcut and --reset-shortcut cannot be used together" >&2
    return 2
  fi

  if [[ -z "$mode" && -z "$model" && -z "$api_key" && -z "$shortcut" && "$clear_api_key" -eq 0 && "$reset_shortcut" -eq 0 ]]; then
    config_set_interactive
    return $?
  fi

  if [[ -n "$mode" ]]; then
    if ! mode="$(normalize_rewrite_mode "$mode" 2>/dev/null)"; then
      echo "invalid mode '$mode'; expected literal|smart" >&2
      return 2
    fi
    write_config_value "$REWRITE_MODE_FILE" "$mode"
  fi

  model="$(trim "$model")"
  if [[ -n "$model" ]]; then
    write_config_value "$OPENROUTER_MODEL_FILE" "$model"
  fi

  api_key="$(trim "$api_key")"
  if [[ -n "$api_key" ]]; then
    write_secret_config_value "$OPENROUTER_API_KEY_FILE" "$api_key"
  fi

  shortcut="$(trim "$shortcut")"
  if [[ -n "$shortcut" ]]; then
    write_shortcut_value "$shortcut"
  fi

  if [[ "$reset_shortcut" -eq 1 ]]; then
    clear_shortcut_value
  fi

  if [[ "$clear_api_key" -eq 1 ]]; then
    rm -f "$OPENROUTER_API_KEY_FILE"
  fi

  echo "config updated:"
  config_get
  shortcut_get
  show_restart_note_if_running
}

config_command() {
  local action="${1:-wizard}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  if [[ "$action" == --* ]]; then
    config_set_non_interactive "$action" "$@"
    return $?
  fi

  case "$action" in
    get)
      config_get
      ;;
    wizard|quick)
      config_set_interactive
      ;;
    set)
      config_set_non_interactive "$@"
      ;;
    -h|--help|help)
      config_usage
      ;;
    *)
      echo "unknown config action: $action" >&2
      config_usage >&2
      return 2
      ;;
  esac
}

ensure_build() {
  (cd "$ROOT_DIR" && swift build --product MurmurMenuBarApp >/dev/null)
}

ensure_capture_build() {
  (cd "$ROOT_DIR" && swift build --product DictationPreviewCLI >/dev/null)
}

ensure_swift_ready() {
  if command -v swift >/dev/null 2>&1 && swift --version >/dev/null 2>&1; then
    return 0
  fi

  echo "swift toolchain is required but was not found." >&2
  echo "install Xcode Command Line Tools, then retry:" >&2
  echo "  xcode-select --install" >&2
  return 1
}

is_running() {
  if [[ ! -f "$PID_FILE" ]]; then
    return 1
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  if [[ -z "$pid" ]]; then
    return 1
  fi

  if kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  rm -f "$PID_FILE"
  return 1
}

start_bg() {
  if is_running; then
    echo "murmur already running (pid $(cat "$PID_FILE"))"
    return 0
  fi

  local python_bin script_path shortcut_identifier rewrite_mode openrouter_model openrouter_api_key
  python_bin="$(resolve_python)"
  script_path="$(resolve_script)"
  shortcut_identifier="$(resolve_shortcut)"
  rewrite_mode="$(resolve_rewrite_mode)"
  openrouter_model="$(resolve_openrouter_model)"
  openrouter_api_key="$(resolve_openrouter_api_key || true)"

  ensure_build
  (
    cd "$ROOT_DIR"
    if [[ -n "$openrouter_api_key" ]]; then
      MURMUR_OPENROUTER_API_KEY="$openrouter_api_key" nohup "$APP_BIN" \
        --moonshine-python "$python_bin" \
        --moonshine-script "$script_path" \
        --shortcut "$shortcut_identifier" \
        --rewrite-mode "$rewrite_mode" \
        --openrouter-model "$openrouter_model" \
        "$@" >"$LOG_FILE" 2>&1 &
    else
      nohup "$APP_BIN" \
        --moonshine-python "$python_bin" \
        --moonshine-script "$script_path" \
        --shortcut "$shortcut_identifier" \
        --rewrite-mode "$rewrite_mode" \
        --openrouter-model "$openrouter_model" \
        "$@" >"$LOG_FILE" 2>&1 &
    fi
    echo $! >"$PID_FILE"
  )

  sleep 0.2
  if is_running; then
    echo "murmur started (pid $(cat "$PID_FILE"))"
    echo "log: $LOG_FILE"
  else
    echo "failed to start murmur; see $LOG_FILE" >&2
    return 1
  fi
}

run_fg() {
  local python_bin script_path shortcut_identifier rewrite_mode openrouter_model openrouter_api_key
  python_bin="$(resolve_python)"
  script_path="$(resolve_script)"
  shortcut_identifier="$(resolve_shortcut)"
  rewrite_mode="$(resolve_rewrite_mode)"
  openrouter_model="$(resolve_openrouter_model)"
  openrouter_api_key="$(resolve_openrouter_api_key || true)"

  ensure_build
  cd "$ROOT_DIR"
  if [[ -n "$openrouter_api_key" ]]; then
    exec env MURMUR_OPENROUTER_API_KEY="$openrouter_api_key" "$APP_BIN" \
      --moonshine-python "$python_bin" \
      --moonshine-script "$script_path" \
      --shortcut "$shortcut_identifier" \
      --rewrite-mode "$rewrite_mode" \
      --openrouter-model "$openrouter_model" \
      "$@"
  else
    exec "$APP_BIN" \
      --moonshine-python "$python_bin" \
      --moonshine-script "$script_path" \
      --shortcut "$shortcut_identifier" \
      --rewrite-mode "$rewrite_mode" \
      --openrouter-model "$openrouter_model" \
      "$@"
  fi
}

stop_bg() {
  if ! is_running; then
    echo "murmur is not running"
    return 0
  fi

  local pid
  pid="$(cat "$PID_FILE")"
  kill "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "murmur stopped"
}

status_bg() {
  if is_running; then
    local pid
    pid="$(cat "$PID_FILE")"
    echo "murmur running (pid $pid)"
    echo "log: $LOG_FILE"
  else
    echo "murmur not running"
  fi
}

history_path() {
  echo "$TRANSCRIPT_DIR"
}

history_show() {
  local line_count="${1:-50}"
  if [[ ! "$line_count" =~ ^[0-9]+$ ]]; then
    echo "history lines must be a number" >&2
    return 2
  fi

  if [[ ! -d "$TRANSCRIPT_DIR" ]]; then
    echo "no transcript history yet"
    return 0
  fi

  local files=()
  while IFS= read -r file; do
    files+=("$file")
  done < <(find "$TRANSCRIPT_DIR" -type f -name '*.txt' | sort)

  if [[ ${#files[@]} -eq 0 ]]; then
    echo "no transcript history yet"
    return 0
  fi

  cat "${files[@]}" | tail -n "$line_count"
}

doctor() {
  echo "repo=$ROOT_DIR"
  echo "binary=$APP_BIN"
  echo "python=$(resolve_python)"
  echo "moonshine_script=$(resolve_script)"
  echo "shortcut=$(resolve_shortcut)"
  echo "shortcut_source=$(shortcut_source)"
  echo "rewrite_mode=$(resolve_rewrite_mode)"
  echo "rewrite_mode_source=$(rewrite_mode_source)"
  echo "openrouter_model=$(resolve_openrouter_model)"
  echo "openrouter_model_source=$(openrouter_model_source)"
  echo "openrouter_api_key_present=$(openrouter_key_present)"
  echo "openrouter_api_key_source=$(openrouter_api_key_source)"
  echo "history_dir=$TRANSCRIPT_DIR"
  if is_running; then
    echo "status=running pid=$(cat "$PID_FILE")"
  else
    echo "status=stopped"
  fi
}

setup_usage() {
  cat <<USAGE
Usage:
  ${COMMAND_NAME} setup
  ${COMMAND_NAME} setup --global
  ${COMMAND_NAME} setup --python /opt/homebrew/bin/python3
  ${COMMAND_NAME} setup --skip-model-download

Options:
  --python <path|name>      Python executable used to create .venv
  --skip-model-download     Skip Moonshine model download
  --global                  Also install global '${COMMAND_NAME}' command
USAGE
}

setup_environment() {
  local setup_python="${MURMUR_SETUP_PYTHON:-python3}"
  local install_global=0
  local skip_model_download=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --python)
      if [[ $# -lt 2 ]]; then
        echo "setup option --python requires a value" >&2
        return 2
      fi
      setup_python="$2"
      shift 2
      ;;
    --skip-model-download)
      skip_model_download=1
      shift
      ;;
    --global)
      install_global=1
      shift
      ;;
    -h|--help)
      setup_usage
      return 0
      ;;
    *)
      echo "unknown setup option: $1" >&2
      setup_usage >&2
      return 2
      ;;
    esac
  done

  if ! command -v "$setup_python" >/dev/null 2>&1; then
    echo "python executable not found: $setup_python" >&2
    echo "set MURMUR_SETUP_PYTHON or pass --python to choose a valid interpreter" >&2
    return 1
  fi

  ensure_swift_ready

  local venv_dir="$ROOT_DIR/.venv"
  local venv_python="$venv_dir/bin/python3"

  if [[ -x "$venv_python" ]]; then
    echo "[1/5] reusing virtual environment: $venv_dir"
  else
    echo "[1/5] creating virtual environment: $venv_dir"
    "$setup_python" -m venv "$venv_dir"
  fi

  if [[ ! -x "$venv_python" ]]; then
    echo "expected python not found at $venv_python after venv creation" >&2
    return 1
  fi

  echo "[2/5] upgrading pip in .venv"
  "$venv_python" -m pip install --upgrade pip

  echo "[3/5] installing moonshine dependencies"
  "$venv_python" -m pip install moonshine-voice useful-moonshine-onnx

  if [[ "$skip_model_download" -eq 1 ]]; then
    echo "[4/5] skipping model download (--skip-model-download)"
  else
    echo "[4/5] downloading moonshine english model"
    "$venv_python" -m moonshine_voice.download --language en
  fi

  echo "[5/5] building Murmur app binary"
  ensure_build

  if [[ "$install_global" -eq 1 ]]; then
    install_cli
  fi

  if [[ "$install_global" -eq 1 ]]; then
    cat <<GUIDE

setup complete.
next steps:
  1) murmur doctor
  2) murmur run
GUIDE
  else
    cat <<GUIDE

setup complete.
next steps:
  1) ./murmur doctor
  2) ./murmur run
GUIDE
    echo "optional: run '${COMMAND_NAME} install' to use 'murmur' from anywhere"
  fi
}

install_usage() {
  cat <<USAGE
Usage:
  ${COMMAND_NAME} install
  ${COMMAND_NAME} install --python /opt/homebrew/bin/python3
  ${COMMAND_NAME} install --skip-model-download
  ${COMMAND_NAME} install --link-only

Behavior:
  Default install runs full setup (venv, deps, model download, app build)
  and installs global '${COMMAND_NAME}' command.

Options:
  --python <path|name>      Python executable used to create .venv
  --skip-model-download     Skip Moonshine model download
  --link-only               Only install global '${COMMAND_NAME}' symlink
USAGE
}

install_command() {
  local link_only=0
  local setup_args=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --python)
      if [[ $# -lt 2 ]]; then
        echo "install option --python requires a value" >&2
        return 2
      fi
      setup_args+=("--python" "$2")
      shift 2
      ;;
    --skip-model-download)
      setup_args+=("--skip-model-download")
      shift
      ;;
    --link-only)
      link_only=1
      shift
      ;;
    -h|--help)
      install_usage
      return 0
      ;;
    *)
      echo "unknown install option: $1" >&2
      install_usage >&2
      return 2
      ;;
    esac
  done

  if [[ "$link_only" -eq 1 ]]; then
    if [[ ${#setup_args[@]} -gt 0 ]]; then
      echo "--link-only cannot be combined with other install options" >&2
      return 2
    fi
    install_cli
    return 0
  fi

  setup_environment "${setup_args[@]}" --global
}

install_cli() {
  local install_dir="${MURMUR_BIN_DIR:-$HOME/.local/bin}"
  mkdir -p "$install_dir"
  ln -sfn "$ROOT_DIR/murmur" "$install_dir/murmur"
  echo "installed murmur -> $install_dir/murmur"
  case ":$PATH:" in
    *":$install_dir:"*) ;;
    *)
      echo "note: add $install_dir to PATH to run 'murmur' from anywhere"
      ;;
  esac
}

uninstall_cli() {
  local install_dir="${MURMUR_BIN_DIR:-$HOME/.local/bin}"
  rm -f "$install_dir/murmur"
  echo "removed $install_dir/murmur"
}

cmd="${1:-run}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$cmd" in
setup)
  setup_environment "$@"
  ;;
run)
  run_fg "$@"
  ;;
start)
  start_bg "$@"
  ;;
stop)
  stop_bg
  ;;
restart)
  stop_bg
  start_bg "$@"
  ;;
status)
  status_bg
  ;;
logs)
  touch "$LOG_FILE"
  tail -f "$LOG_FILE"
  ;;
history)
  history_show "$@"
  ;;
history-path)
  history_path
  ;;
config)
  config_command "$@"
  ;;
shortcut)
  shortcut_command "$@"
  ;;
doctor)
  doctor
  ;;
install)
  install_command "$@"
  ;;
uninstall)
  uninstall_cli
  ;;
help|-h|--help)
  usage
  ;;
*)
  usage >&2
  exit 2
  ;;
esac
